# Optional: copy to .env. Defaults work without a file.
# This local mock uses fictional accounts and stores everything in memory.
# If you change the API port, also update proxy.conf.json and restart Angular.
MOCK_API_PORT=3000

# Short access expiry makes the later refresh flow easy to demonstrate.
MOCK_ACCESS_TTL_SECONDS=30
MOCK_REFRESH_TTL_SECONDS=3600
MOCK_LATENCY_MS=150

# Use 1 to fail the first otherwise valid list/save request with HTTP 503.
# Each fault happens once per server run and leaves stored data unchanged.
MOCK_FAIL_LIST_ONCE=0
MOCK_FAIL_SAVE_ONCE=0
