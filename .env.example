# Copy to .env and adjust. Do not commit real secrets.

JWT_SECRET=replace-with-long-random-string-for-production

# Optional: override seed accounts (used on first empty database only)
SEED_REVIEWER_EMAIL=reviewer@example.com
SEED_REVIEWER_PASSWORD=CHANGEME_reviewer_123
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGEME_admin_123

# Backend reads these; compose passes DATABASE_URL by default
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Frontend (browser must reach API on host machine)
VITE_API_URL=http://localhost:8000
